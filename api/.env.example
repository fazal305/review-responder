APP_NAME="Review Responder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8472

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=review_responder
DB_USERNAME=review_responder
DB_PASSWORD=
# PostgreSQL (DB_CONNECTION=pgsql): the schema to use, and "require" for hosted databases.
# DB_SEARCH_PATH=public
# DB_SSLMODE=prefer

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="briefing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin(s) of the web app, comma-separated. Used for CORS and the post-sign-in redirect (first entry).
FRONTEND_URL=http://localhost:5472
SANCTUM_EXPIRATION=10080

# Google Business Profile: "demo" (labelled sample locations and reviews) or "real".
GOOGLE_DRIVER=demo
# Google sign-in is offered only when all three are set. The redirect URI must point at
# this API's /api/auth/google/callback and be registered in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8472/api/auth/google/callback

# "Try the demo" sign-in (creates an isolated demo account).
DEMO_LOGIN_ENABLED=true

# Any OpenAI-compatible chat completions endpoint. Without a key, demo drafts use a labelled template.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free

# Shared secret for POST /api/cron/run (external scheduler on hosts without cron). Empty disables it.
CRON_SECRET=
